<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Gestor Turnos</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

@* El menú está agrupado por tipo de tarea y, adentro de cada grupo, primero lo
   que se usa todos los días. *@
<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Inicio
            </NavLink>
        </div>

        <AuthorizeView Roles="Secretario,Portero">
            <div class="nav-seccion">Día a día</div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="salidas">
                    <span class="bi bi-box-arrow-up-right-nav-menu" aria-hidden="true"></span> Salidas de curso
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="retiros">
                    <span class="bi bi-box-arrow-right-nav-menu" aria-hidden="true"></span> Retiros
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="alumnos">
                    <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> Alumnos
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="horariosespeciales">
                    <span class="bi bi-clock-fill-nav-menu" aria-hidden="true"></span> Horarios esp.
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="Tutor">
            <div class="nav-seccion">Día a día</div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="mis-alumnos">
                    <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> Mis alumnos
                </NavLink>
            </div>
        </AuthorizeView>

        <div class="nav-seccion">Administración</div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="cursos">
                <span class="bi bi-book-fill-nav-menu" aria-hidden="true"></span> Cursos
            </NavLink>
        </div>
        <AuthorizeView Roles="Secretario,Portero">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="tutores">
                    <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> Tutores
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="Secretario,Portero">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="autorizaciones">
                    <span class="bi bi-shield-lock-fill-nav-menu" aria-hidden="true"></span> Autorizaciones
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="Secretario,Portero">
            <div class="nav-seccion">Reportes</div>

            @* El reporte de alumnos es de gestión: lo ve sólo el secretario. *@
            <AuthorizeView Roles="Secretario" Context="reporteDeAlumnos">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="reportealumnos">
                        <span class="bi bi-bar-chart-fill-nav-menu" aria-hidden="true"></span> Rep. alumnos
                    </NavLink>
                </div>
            </AuthorizeView>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="reporteretiros">
                    <span class="bi bi-table-nav-menu" aria-hidden="true"></span> Rep. retiros
                </NavLink>
            </div>

            @* La pantalla de la puerta se abre en otra ventana, para dejarla
               fija en el televisor o el monitor de la entrada. *@
            <div class="nav-seccion">Pantalla de la puerta</div>
            <div class="nav-item px-3">
                <a class="nav-link" href="cartelera" target="_blank" rel="noopener">
                    <span class="bi bi-display-nav-menu" aria-hidden="true"></span> Pantalla de salida
                </a>
            </div>
        </AuthorizeView>
    </nav>
</div>
