@page "/login"
@layout EmptyLayout
@inject IAuthService AuthService
@inject NavigationManager Nav

<PageTitle>Iniciar sesión</PageTitle>

<div class="login-wrapper">
    <div class="card login-card shadow">
        <div class="card-body p-4">

            <div class="text-center mb-4">
                <h3 class="mb-1">Gestor de Turnos Escolar</h3>
                <p class="text-muted mb-0">Sistema de gestión de retiros</p>
            </div>

            <EditForm Model="loginModel" OnValidSubmit="HandleLogin" FormName="login">
                <div class="mb-3">
                    <label class="form-label">Usuario</label>
                    <InputText @bind-Value="loginModel.Username" class="form-control" placeholder="Ingrese su usuario" disabled="@(!interactivo)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Contraseña</label>
                    <InputText @bind-Value="loginModel.Password" type="password" class="form-control" placeholder="Ingrese su contraseña" disabled="@(!interactivo)" />
                </div>

                @if (mensajeError is not null)
                {
                    <div class="alert alert-danger py-2 mb-3">
                        @mensajeError
                    </div>
                }

                @* Los casilleros y el botón se habilitan cuando el circuito ya está
                   conectado. Mientras tanto el formulario se ve (por el
                   prerenderizado) pero no se puede usar: si no, lo que alguien
                   escriba se pierde cuando Blazor toma el control, y un envío
                   apurado saldría como POST normal contra el servidor. *@
                <button type="submit" class="btn btn-primary w-100 py-2" disabled="@(cargando || !interactivo)">
                    @(cargando ? "Ingresando..." : "Ingresar")
                </button>
            </EditForm>
        </div>
    </div>
</div>

<style>
    .login-wrapper {
        min-height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .login-card {
        width: 100%;
        max-width: 400px;
        border: 0;
        border-radius: 12px;
    }
</style>

@code {
    private LoginData loginModel = new();
    private string? mensajeError;
    private bool cargando;
    private bool interactivo;

    protected override void OnAfterRender(bool primerRender)
    {
        // Con el prerenderizado el formulario ya se ve antes de que Blazor esté
        // activo; recién acá el circuito está escuchando de verdad.
        if (primerRender)
        {
            interactivo = true;
            StateHasChanged();
        }
    }

    private async Task HandleLogin()
    {
        mensajeError = null;
        cargando = true;

        try
        {
            if (await AuthService.LoginAsync(loginModel.Username, loginModel.Password))
                Nav.NavigateTo("/");
            else
                mensajeError = "Usuario o contraseña incorrectos.";
        }
        catch (ApiNoDisponibleException ex)
        {
            // Sin este caso aparte, cuando la API no está levantada la pantalla
            // decía "usuario o contraseña incorrectos" y no se entendía el problema.
            mensajeError = ex.Message;
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo iniciar sesión: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    public class LoginData
    {
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
