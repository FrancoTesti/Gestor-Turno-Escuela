@page "/login"
@layout EmptyLayout

<PageTitle>Iniciar sesión</PageTitle>

<div class="login-wrapper">
    <div class="card login-card shadow">
        <div class="card-body p-4">

            <div class="text-center mb-4">
                <h3 class="mb-1">Gestor de Turnos Escolar</h3>
                <p class="text-muted mb-0">Sistema de gestión de retiros</p>
            </div>

            @if (mensajeError is not null)
            {
                <div class="alert alert-danger py-2 mb-3">@mensajeError</div>
            }

            <form method="post" action="/cuenta/entrar">
                <div class="mb-3">
                    <label class="form-label" for="usuario">Usuario</label>
                    <input id="usuario" name="usuario" class="form-control"
                           placeholder="Ingrese su usuario" autocomplete="username" autofocus />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="clave">Contraseña</label>
                    <input id="clave" name="clave" type="password" class="form-control"
                           placeholder="Ingrese su contraseña" autocomplete="current-password" />
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2">Ingresar</button>
            </form>
        </div>
    </div>
</div>

<style>
    .login-wrapper {
        min-height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .login-card {
        width: 100%;
        max-width: 400px;
        border: 0;
        border-radius: 12px;
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    private string? mensajeError => Error switch
    {
        "datos" => "Usuario o contraseña incorrectos.",
        "api" => "No se pudo conectar con la API. Verificá que el proyecto GTE.WebAPI esté en ejecución.",
        _ => null
    };
}
