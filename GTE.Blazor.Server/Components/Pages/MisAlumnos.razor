@page "/mis-alumnos"
@attribute [Authorize(Roles = "Tutor")]
@inherits PaginaConApiBase
@inject TutorApiClient TutoresClient
@inject IAsistenciaApiClient AsistenciaClient
@implements IDisposable

<PageTitle>Mis alumnos</PageTitle>

<div class="d-flex justify-content-between align-items-start">
    <h3 class="mb-1">Mis alumnos a cargo</h3>
    <button class="btn btn-outline-primary btn-sm" @onclick="CargarAsync" disabled="@cargando">
        @(cargando ? "Actualizando..." : "Actualizar")
    </button>
</div>

@if (!string.IsNullOrEmpty(MensajeError))
{
    <div class="alert alert-danger alerta-flotante">@MensajeError</div>
}

@if (alumnos == null)
{
    <p><em>Cargando...</em></p>
}
else if (alumnos.Count == 0)
{
    <div class="ma-aviso-vacio">
        <p class="mb-1">Todavía no tenés alumnos a cargo.</p>
        <p class="mb-0 ma-apagado">
            La autorización la carga la secretaría: pedí que registren tu nombre y tu DNI
            para los chicos que retirás. Sin esa autorización la portería no puede entregarlos.
        </p>
    </div>
}
else
{
    <p class="ma-resumen">@Resumen</p>

    @if (AlumnosSaliendo.Count > 0)
    {
        <div class="ma-aviso-saliendo">
            <p class="ma-aviso-titulo">@TextoDeAhora</p>
            <p class="ma-aviso-detalle">Decile tu DNI a la portería para que registren la entrega.</p>
        </div>
    }
    else
    {
        <div class="ma-aviso-tranquilo">
            <p class="mb-0">Ahora no está saliendo ninguno de tus cursos. @TextoSiguiente</p>
        </div>
    }

    <h5 class="ma-seccion">Salidas de hoy</h5>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th style="width: 100px;">Sale</th>
                    <th>Alumno</th>
                    <th style="width: 130px;">Curso</th>
                    <th style="width: 130px;">Turno</th>
                    <th style="width: 150px;">Estado</th>
                    <th style="width: 160px;" class="text-center">Asistencias</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in AlumnosOrdenados)
                {
                    <tr class="@(a.EstaSaliendo ? "ma-fila-saliendo" : null)">
                        <td class="ma-hora">@a.HorarioSalida.ToString(@"hh\:mm")</td>
                        <td>
                            <strong>@a.Nombre @a.Apellido</strong>
                            @if (a.EstaSaliendo)
                            {

                                <span class="badge bg-primary ms-2">Está saliendo</span>
                            }
                        </td>
                        <td>@a.Grado @a.Curso</td>
                        <td>@a.Turno</td>
                        <td><EstadoBadge Estado="@a.Estado" /></td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => VerHistorialAsync(a)">
                                Ver Asistencias
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h5 class="ma-seccion">Cómo retirar a un alumno</h5>

    <div class="ma-ayuda">
        <p class="mb-2">
            Cuando el curso termina su horario, esperá en la puerta y decile tu DNI a la
            portería: ahí registran la entrega del alumno.
        </p>
        <p class="mb-0">
            Si necesitás retirarlo antes de esa hora, la secretaría puede cargar un
            horario especial para ese día.
        </p>
    </div>
}

@if (mostrarModalHistorial && historialAlumno != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        Historial de Asistencias — @historialAlumno.NombreCompleto
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalHistorial"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-4 text-center">
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded border">
                                <div class="text-muted small">Faltas Computables</div>
                                <h3 class="mb-0 text-danger fw-bold">@historialAlumno.TotalFaltasComputables.ToString("0.##")</h3>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded border">
                                <div class="text-muted small">Faltas Justificadas</div>
                                <h3 class="mb-0 text-info fw-bold">@historialAlumno.TotalFaltasJustificadas.ToString("0.##")</h3>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded border">
                                <div class="text-muted small">Faltas Injustificadas</div>
                                <h3 class="mb-0 text-secondary fw-bold">@historialAlumno.TotalFaltasInjustificadas.ToString("0.##")</h3>
                            </div>
                        </div>
                    </div>

                    @if (historialAlumno.Inasistencias.Count == 0)
                    {
                        <div class="alert alert-success">
                            El alumno no registra inasistencias a la fecha. ¡Asistencia completa!
                        </div>
                    }
                    else
                    {
                        <h6 class="fw-bold mb-2">Detalle de Inasistencias:</h6>
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Tipo Inasistencia</th>
                                        <th class="text-center">Código</th>
                                        <th class="text-center">Valor</th>
                                        <th class="text-center">Justificada</th>
                                        <th>Motivo</th>
                                        <th>Observaciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var inas in historialAlumno.Inasistencias)
                                    {
                                        <tr>
                                            <td>@inas.Fecha.ToString("dd/MM/yyyy")</td>
                                            <td><strong>@inas.NombreTipoInasistencia</strong></td>
                                            <td class="text-center"><span class="badge bg-dark">@inas.CodigoOficial</span></td>
                                            <td class="text-center">@inas.ValorDecimal.ToString("0.##")</td>
                                            <td class="text-center">
                                                @if (inas.Justificada)
                                                {
                                                    <span class="badge bg-info text-dark">Sí (J)</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">No (I)</span>
                                                }
                                            </td>
                                            <td>@(string.IsNullOrWhiteSpace(inas.Motivo) ? "-" : inas.Motivo)</td>
                                            <td><small>@(string.IsNullOrWhiteSpace(inas.Observaciones) ? "-" : inas.Observaciones)</small></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalHistorial">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}


<style>
    .ma-resumen {
        color: #495057;
        margin-bottom: 1rem;
    }

    .ma-aviso-saliendo {
        background-color: #0a58ca;
        color: #ffffff;
        border-radius: 10px;
        padding: 16px 20px;
        margin-bottom: 1.5rem;
    }

    .ma-aviso-titulo {
        font-size: 1.05rem;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .ma-aviso-detalle {
        color: rgba(255, 255, 255, 0.88);
        margin-bottom: 0;
    }

    .ma-aviso-tranquilo {
        background-color: #f1f3f5;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        color: #343a40;
        padding: 14px 20px;
        margin-bottom: 1.5rem;
    }

    .ma-aviso-vacio {
        background-color: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px 24px;
    }

    .ma-apagado {
        color: #495057;
    }

    .ma-seccion {
        margin-top: 2rem;
        margin-bottom: 0.75rem;
    }

    .ma-hora {
        font-variant-numeric: tabular-nums;
        font-weight: 600;
    }

    .ma-fila-saliendo {
        --bs-table-bg: #e7f1ff;
        --bs-table-striped-bg: #e7f1ff;
        --bs-table-hover-bg: #dbe9ff;
    }

    .ma-ayuda {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        color: #495057;
        padding: 16px 20px;
        max-width: 75ch;
    }
</style>

@code {
    private List<AlumnoACargoDTO>? alumnos;
    private bool cargando;
    private readonly CancellationTokenSource cancelacion = new();
    private bool mostrarModalHistorial;
    private HistorialAsistenciaAlumnoDTO? historialAlumno;

    private async Task VerHistorialAsync(AlumnoACargoDTO alumno)
    {
        await EjecutarAsync(async () =>
        {
            historialAlumno = await AsistenciaClient.GetHistorialAlumnoAsync(alumno.IdAlumno);
            mostrarModalHistorial = true;
        });
    }

    private void CerrarModalHistorial()
    {
        mostrarModalHistorial = false;
        historialAlumno = null;
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();

        _ = RefrescarCadaVeinteSegundosAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;

        await EjecutarAsync(async () =>
        {
            alumnos = await TutoresClient.GetMisAlumnosAsync();
        });

        cargando = false;
    }

    private async Task RefrescarCadaVeinteSegundosAsync()
    {
        try
        {
            while (!cancelacion.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(20), cancelacion.Token);

                alumnos = await TutoresClient.GetMisAlumnosAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception)
        {
        }
    }

    public void Dispose() => cancelacion.Cancel();

    private List<AlumnoACargoDTO> AlumnosOrdenados =>
        (alumnos ?? new List<AlumnoACargoDTO>())
            .OrderBy(a => a.HorarioSalida)
            .ThenBy(a => a.Apellido)
            .ToList();

    private List<AlumnoACargoDTO> AlumnosSaliendo =>
        AlumnosOrdenados.Where(a => a.EstaSaliendo).ToList();

    private string Resumen
    {
        get
        {
            var todos = AlumnosOrdenados;
            if (todos.Count == 0)
                return string.Empty;

            int cursos = todos.Select(a => $"{a.Grado} {a.Curso}").Distinct().Count();

            string alumnosTexto = todos.Count == 1 ? "1 alumno a cargo" : $"{todos.Count} alumnos a cargo";
            string cursosTexto = cursos == 1 ? "en 1 curso" : $"en {cursos} cursos";

            string horarios = Listar(
                todos.Select(a => a.HorarioSalida.ToString(@"hh\:mm")).Distinct().OrderBy(h => h));

            return $"Tenés {alumnosTexto} {cursosTexto}. Hoy salen a las {horarios}.";
        }
    }

    private string TextoDeAhora
    {
        get
        {
            var saliendo = AlumnosSaliendo;
            var cursos = saliendo.Select(a => $"{a.Grado} {a.Curso}").Distinct().ToList();
            string nombres = Listar(saliendo.Select(a => $"{a.Nombre} {a.Apellido}"));

            return cursos.Count == 1
                ? $"Ahora está saliendo {cursos[0]}: {nombres}."
                : $"Ahora están saliendo {Listar(cursos)}: {nombres}.";
        }
    }

    private string TextoSiguiente
    {
        get
        {
            var todos = AlumnosOrdenados;
            if (todos.Count == 0)
                return string.Empty;

            TimeSpan ahora = DateTime.Now.TimeOfDay;
            var proximo = todos
                .Where(a => a.HorarioSalida >= ahora)
                .OrderBy(a => a.HorarioSalida)
                .FirstOrDefault();

            return proximo is null
                ? "Ya pasaron todos los horarios de hoy."
                : $"La próxima es a las {proximo.HorarioSalida.ToString(@"hh\:mm")} ({proximo.Grado} {proximo.Curso}).";
        }
    }

    private static string Listar(IEnumerable<string> elementos)
    {
        var lista = elementos.ToList();

        return lista.Count switch
        {
            0 => string.Empty,
            1 => lista[0],
            _ => $"{string.Join(", ", lista.Take(lista.Count - 1))} y {lista[^1]}"
        };
    }
}
