@page "/reportealumnos"
@attribute [Authorize(Roles = "Secretario,Portero")]
@inherits PaginaConApiBase
@inject GTE.Clients.ReporteApiClient ReporteClient
@using GTE.DTOs

<h3>Reporte: Alumnos por Curso y Turno</h3>

@if (!string.IsNullOrEmpty(MensajeError))
{
    <div class="alert alert-danger">@MensajeError</div>
}

@if (datos == null) { <p><em>Cargando...</em></p> }
else
{
    <div class="card mb-4">
        <div class="card-body text-center">
            <h5>Gráfico de Alumnos</h5>
            <svg width="800" height="300" style="border: 1px solid #ccc; background: #f9f9f9; padding: 10px;">
                @if (datos.Count > 0)
                {
                    int maxCantidad = datos.Max(d => d.Cantidad) == 0 ? 1 : datos.Max(d => d.Cantidad);
                    int barWidth = 40;
                    int gap = 20;
                    int svgHeight = 250;
                    int startX = 50;

                    for (int i = 0; i < datos.Count; i++)
                    {
                        var d = datos[i];
                        int barHeight = (int)((double)d.Cantidad / maxCantidad * 200);
                        int x = startX + i * (barWidth + gap);
                        int y = svgHeight - barHeight;
                        string color = d.Turno.Contains("Mañana") ? "#4CAF50" : (d.Turno.Contains("Tarde") ? "#2196F3" : "#FF9800");

                        <!-- Barra -->
                        <rect x="@x" y="@y" width="@barWidth" height="@barHeight" fill="@color" />
                        
                        <!-- Etiqueta de cantidad arriba de la barra -->
                        @((MarkupString)$"<text x='{x + barWidth/2}' y='{y - 5}' font-size='12' text-anchor='middle' fill='#000'>{d.Cantidad}</text>")
                        
                        <!-- Etiqueta del curso debajo -->
                        @((MarkupString)$"<text x='{x + barWidth/2}' y='{svgHeight + 15}' font-size='10' text-anchor='middle' fill='#000'>{d.Grado} {d.Curso}</text>")
                        @((MarkupString)$"<text x='{x + barWidth/2}' y='{svgHeight + 30}' font-size='10' text-anchor='middle' fill='#555'>{d.Turno}</text>")
                    }
                }
            </svg>
            <div class="mt-3">
                <span class="badge" style="background-color: #4CAF50; color: white;">Mañana</span>
                <span class="badge" style="background-color: #2196F3; color: white;">Tarde</span>
                <span class="badge" style="background-color: #FF9800; color: white;">Noche</span>
            </div>
        </div>
    </div>

    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Turno</th>
                <th>Grado</th>
                <th>División (Curso)</th>
                <th>Cantidad de Alumnos</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in datos)
            {
                <tr>
                    <td>@d.Turno</td>
                    <td>@d.Grado</td>
                    <td>@d.Curso</td>
                    <td>@d.Cantidad</td>
                </tr>
            }
            <tr>
                <td colspan="3" class="text-end fw-bold">TOTAL:</td>
                <td class="fw-bold">@(datos.Sum(x => x.Cantidad))</td>
            </tr>
        </tbody>
    </table>
}

@code {
    private List<ReporteAlumnosPorCursoDTO>? datos;

    protected override async Task OnInitializedAsync()
    {
        await EjecutarAsync(async () => {
            datos = await ReporteClient.ObtenerAlumnosPorCursoAsync();
        });
    }
}

