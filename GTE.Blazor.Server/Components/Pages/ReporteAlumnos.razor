@page "/reportealumnos"

@attribute [Authorize(Roles = "Secretario")]
@inherits PaginaConApiBase
@inject GTE.Clients.ReporteApiClient ReporteClient
@using GTE.DTOs

<h3>Reporte: Alumnos por Curso y Turno</h3>

@if (!string.IsNullOrEmpty(MensajeError))
{
    <div class="alert alert-danger">@MensajeError</div>
}

@if (datos == null) { <p><em>Cargando...</em></p> }
else
{
    <div class="card mb-4">
        <div class="card-body text-center">
            <h5>Gráfico de Alumnos</h5>
            @{
                int maxCantidad = datos.Count > 0 ? Math.Max(1, datos.Max(d => d.Cantidad)) : 1;
                const int AnchoSvg = 820;
                const int AltoSvg = 330;
                const int BaseY = 250;
                const int AltoMaximoBarra = 190;
                const int MargenIzquierdo = 50;

                int paso = datos.Count == 0
                    ? 90
                    : Math.Min(90, Math.Max(38, (AnchoSvg - MargenIzquierdo - 20) / datos.Count));

                int anchoBarra = Math.Max(14, paso - 14);
            }


            <svg width="@AnchoSvg" height="@AltoSvg" style="border: 1px solid #ccc; background: #f9f9f9;">
                @for (int i = 0; i < datos.Count; i++)
                {
                    var d = datos[i];
                    int altoBarra = (int)((double)d.Cantidad / maxCantidad * AltoMaximoBarra);
                    int x = MargenIzquierdo + (i * paso);
                    int y = BaseY - altoBarra;
                    int centro = x + (anchoBarra / 2);
                    string color = d.Turno.Contains("Mañana") ? "#4CAF50"
                        : d.Turno.Contains("Tarde") ? "#2196F3" : "#FF9800";

                    string nombreCurso = System.Net.WebUtility.HtmlEncode($"{d.Grado} {d.Curso}");
                    string nombreTurno = System.Net.WebUtility.HtmlEncode(d.Turno);

                    <rect x="@x" y="@y" width="@anchoBarra" height="@altoBarra" fill="@color" />

                    @((MarkupString)$"<text x='{centro}' y='{y - 6}' font-size='12' text-anchor='middle' fill='#000'>{d.Cantidad}</text>")
                    @((MarkupString)$"<text x='{centro}' y='{BaseY + 18}' font-size='11' text-anchor='middle' fill='#000'>{nombreCurso}</text>")
                    @((MarkupString)$"<text x='{centro}' y='{BaseY + 34}' font-size='11' text-anchor='middle' fill='#555'>{nombreTurno}</text>")
                }
            </svg>
            <div class="mt-3">
                <span class="badge" style="background-color: #4CAF50; color: white;">Mañana</span>
                <span class="badge" style="background-color: #2196F3; color: white;">Tarde</span>
                <span class="badge" style="background-color: #FF9800; color: white;">Noche</span>
            </div>
        </div>
    </div>

    <table class="table table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>Turno</th>
                <th>Grado</th>
                <th>División (Curso)</th>
                <th>Cantidad de Alumnos</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in datos)
            {
                <tr>
                    <td>@d.Turno</td>
                    <td>@d.Grado</td>
                    <td>@d.Curso</td>
                    <td>@d.Cantidad</td>
                </tr>
            }
            <tr>
                <td colspan="3" class="text-end fw-bold">TOTAL:</td>
                <td class="fw-bold">@(datos.Sum(x => x.Cantidad))</td>
            </tr>
        </tbody>
    </table>
}

@code {
    private List<AlumnosPorCursoDTO>? datos;

    protected override async Task OnInitializedAsync()
    {
        await EjecutarAsync(async () => {
            datos = await ReporteClient.GetAlumnosPorCursoAsync();
        });
    }
}

