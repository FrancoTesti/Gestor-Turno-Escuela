@page "/alumnos"
@attribute [Authorize(Roles = "Secretario,Portero")]
@inherits PaginaConApiBase
@inject AlumnoApiClient AlumnosClient
@inject CursoEscolarApiClient CursosClient

<h3>Gestión de Alumnos</h3>

@if (!string.IsNullOrEmpty(MensajeError))
{
    <div class="alert alert-danger">@MensajeError</div>
}

<div class="card mb-3">
    <div class="card-body">
        <h6 class="card-subtitle mb-3 text-muted">Buscar por filtros</h6>
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Nombre o apellido</label>
                <input class="form-control" @bind="filtro.Nombre" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Grado</label>
                <input class="form-control" @bind="filtro.Grado" />
            </div>
            <div class="col-md-2">
                <label class="form-label">División</label>
                <input class="form-control" @bind="filtro.Curso" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Estado</label>
                <select class="form-control" @bind="filtro.Estado">
                    <option value="">Todos</option>
                    <option value="Presente">Presente</option>
                    <option value="Retirado">Retirado</option>
                    <option value="Ausente">Ausente</option>
                </select>
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary" @onclick="Buscar">Buscar</button>
                <button class="btn btn-outline-secondary" @onclick="LimpiarFiltros">Limpiar</button>
            </div>
        </div>
    </div>
</div>

<AuthorizeView Roles="Secretario">
    <Authorized>
        <button class="btn btn-primary mb-3" @onclick="AbrirModalNuevo">Nuevo Alumno</button>
    </Authorized>
</AuthorizeView>

@if (alumnos == null) { <p><em>Cargando...</em></p> }
else if (alumnos.Count == 0)
{
    <p>No se encontraron alumnos con esos filtros.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre y Apellido</th>
                <th>Grado y Curso</th>
                <th>Turno</th>
                <th>Estado</th>
                <AuthorizeView Roles="Secretario">
                    <Authorized><th>Acciones</th></Authorized>
                </AuthorizeView>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in alumnos)
            {
                <tr>
                    <td>@a.Nombre @a.Apellido</td>
                    <td>@a.Grado @a.Curso</td>
                    <td>@a.Turno</td>
                    <td>@a.Estado</td>
                    <AuthorizeView Roles="Secretario">
                        <Authorized>
                            <td>
                                <button class="btn btn-warning btn-sm" @onclick="() => AbrirModalEditar(a)">Editar</button>
                                <button class="btn btn-danger btn-sm" @onclick="() => Eliminar(a.IdAlumno)">Borrar</button>
                            </td>
                        </Authorized>
                    </AuthorizeView>
                </tr>
            }
        </tbody>
    </table>
}

@if (mostrarModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(alumnoEditando.IdAlumno == 0 ? "Nuevo Alumno" : "Editar Alumno")</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="alumnoEditando" OnValidSubmit="Guardar">
                        <div class="mb-3">
                            <label>Nombre</label>
                            <InputText @bind-Value="alumnoEditando.Nombre" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label>Apellido</label>
                            <InputText @bind-Value="alumnoEditando.Apellido" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label>Curso Asignado</label>
                            <InputSelect @bind-Value="alumnoEditando.IdCurso" class="form-control">
                                <option value="0">-- Seleccionar Curso --</option>
                                @if (cursos != null)
                                {
                                    @foreach (var c in cursos)
                                    {
                                        <option value="@c.IdCurso">@c.Grado @c.Curso (@c.Turno)</option>
                                    }
                                }
                            </InputSelect>
                        </div>
                        <div class="mb-3">
                            <label>Estado</label>
                            <InputSelect @bind-Value="alumnoEditando.Estado" class="form-control">
                                <option value="Presente">Presente</option>
                                <option value="Retirado">Retirado</option>
                                <option value="Ausente">Ausente</option>
                            </InputSelect>
                        </div>
                        <div class="mt-4 text-end">
                            <button type="button" class="btn btn-secondary me-2" @onclick="CerrarModal">Cancelar</button>
                            <button type="submit" class="btn btn-primary">Guardar</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<AlumnoDTO>? alumnos;
    private List<CursoEscolarDTO>? cursos;
    private AlumnoDTO alumnoEditando = new();
    private FiltroDeAlumnos filtro = new();
    private bool mostrarModal;

    protected override async Task OnInitializedAsync()
    {
        await EjecutarAsync(async () =>
        {
            await CargarDatos();
            cursos = (await CursosClient.GetAllAsync()).ToList();
        });
    }

    private async Task CargarDatos() => alumnos = (await AlumnosClient.GetAllAsync()).ToList();

    /// <summary>
    /// Busca con los filtros cargados. Recorre el endpoint de criterios, que es
    /// el que resuelve la consulta con ADO.NET del lado de la API.
    /// </summary>
    private async Task Buscar() => await EjecutarAsync(async () =>
        alumnos = (await AlumnosClient.GetByCriteriaAsync(filtro.ToCriteria())).ToList());

    private async Task LimpiarFiltros()
    {
        filtro.Limpiar();
        await EjecutarAsync(CargarDatos);
    }

    private void AbrirModalNuevo()
    {
        alumnoEditando = new AlumnoDTO { Estado = "Presente" };
        mostrarModal = true;
    }

    private void AbrirModalEditar(AlumnoDTO alumno)
    {
        alumnoEditando = new AlumnoDTO
        {
            IdAlumno = alumno.IdAlumno,
            Nombre = alumno.Nombre,
            Apellido = alumno.Apellido,
            IdCurso = alumno.IdCurso,
            Estado = alumno.Estado
        };
        mostrarModal = true;
    }

    private void CerrarModal() => mostrarModal = false;

    private async Task Guardar()
    {
        if (alumnoEditando.IdCurso == 0) return; // Validación simple

        await EjecutarAsync(async () =>
        {
            if (alumnoEditando.IdAlumno == 0)
                await AlumnosClient.AddAsync(alumnoEditando);
            else
                await AlumnosClient.UpdateAsync(alumnoEditando);

            mostrarModal = false;
            await CargarDatos();
        });
    }

    private async Task Eliminar(int id)
    {
        await EjecutarAsync(async () =>
        {
            await AlumnosClient.DeleteAsync(id);
            await CargarDatos();
        });
    }
}
