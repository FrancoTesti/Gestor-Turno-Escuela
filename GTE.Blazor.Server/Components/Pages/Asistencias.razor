@page "/asistencias"
@attribute [Authorize(Roles = "Secretario,Portero")]
@inherits PaginaConApiBase
@inject IAsistenciaApiClient AsistenciaClient
@inject CursoEscolarApiClient CursoClient

<PageTitle>Carga de Asistencias Diarias</PageTitle>

<h3>Carga Diaria de Asistencias</h3>

@if (!string.IsNullOrEmpty(MensajeError))
{
    <div class="alert alert-danger alert-dismissible fade show alerta-flotante" role="alert">
        @MensajeError
        <button type="button" class="btn-close" @onclick="() => MensajeError = string.Empty"></button>
    </div>
}

@if (!string.IsNullOrEmpty(mensajeExito))
{
    <div class="alert alert-success alert-dismissible fade show alerta-flotante" role="alert">
        @mensajeExito
        <button type="button" class="btn-close" @onclick="() => mensajeExito = string.Empty"></button>
    </div>
}

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label fw-bold">Curso:</label>
                <select class="form-select" @bind="idCursoSeleccionado">
                    <option value="0">-- Seleccione un curso --</option>
                    @foreach (var c in cursos)
                    {
                        <option value="@c.IdCurso">@c.Grado @c.Curso (@c.Turno)</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold">Fecha:</label>
                <input type="date" class="form-control" @bind="fechaSeleccionada" />
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary w-100" @onclick="CargarPlanillaAsync" disabled="@(idCursoSeleccionado <= 0 || cargando)">
                    @(cargando ? "Cargando..." : "Cargar Planilla")
                </button>
            </div>
        </div>
    </div>
</div>

@if (planilla != null)
{
    <div class="card mb-3 shadow-sm border-0">
        <div class="card-body bg-light rounded d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h5 class="mb-1 text-primary">
                    Planilla de Asistencia — @planilla.CursoNombre (@planilla.Turno)
                </h5>
                <div class="text-muted small">
                    Fecha: <strong>@planilla.Fecha.ToString("dd/MM/yyyy")</strong> |
                    Alumnos matriculados: <strong>@planilla.Alumnos.Count</strong> |
                    Estado:
                    @if (planilla.Confirmada)
                    {
                        <span class="badge bg-success ms-1">Confirmada</span>
                        @if (planilla.FechaHoraRegistro.HasValue)
                        {
                            <span class="ms-1 small text-muted">(@planilla.FechaHoraRegistro.Value.ToString("dd/MM/yyyy HH:mm"))</span>
                        }
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark ms-1">Pendiente de Confirmación</span>
                    }
                </div>
            </div>
            <div>
                <button class="btn btn-success" @onclick="GuardarPlanillaAsync" disabled="@guardando">
                    @(guardando ? "Guardando..." : "Guardar y Confirmar Planilla")
                </button>
            </div>
        </div>
    </div>

    @if (sugerenciasAplicadas.Count > 0)
    {
        <div class="alert alert-warning py-2 px-3 mb-3 d-flex align-items-start">
            <span class="bi bi-info-circle-fill fs-5 me-2 text-warning flex-shrink-0 mt-1"></span>
            <div>
                <strong>Sugerencias aplicadas automáticamente por retiros del día:</strong>
                <ul class="mb-0 ps-3 small mt-1">
                    @foreach (var sug in sugerenciasAplicadas)
                    {
                        <li>@sug</li>
                    }
                </ul>
                <div class="small text-muted mt-1">
                    Verifique si estas sugerencias corresponden a la jornada de hoy. Puede desmarcar la casilla de ausente o presionar <em>Modificar</em> si desea cambiar las condiciones.
                </div>
            </div>
        </div>
    }

    @if (planilla.Alumnos.Count == 0)
    {
        <div class="alert alert-info">No hay alumnos inscriptos en este curso.</div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 80px;" class="text-center">Ausente</th>
                        <th>Alumno</th>
                        <th style="width: 120px;">Estado</th>
                        <th style="width: 160px;">Tipo Inasistencia</th>
                        <th style="width: 80px;" class="text-center">Código</th>
                        <th style="width: 90px;" class="text-center">Justificada</th>
                        <th>Motivo</th>
                        <th style="width: 100px;" class="text-center">No Computa</th>
                        <th>Retiro Asociado</th>
                        <th class="text-center" style="width: 100px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var alu in planilla.Alumnos)
                    {
                        bool esAusente = alu.IdTipoInasistencia.HasValue && alu.IdTipoInasistencia!.Value > 0;
                        <tr>
                            <td class="text-center">
                                <input type="checkbox" class="form-check-input"
                                       checked="@esAusente"
                                       @onchange="@(e => ToggleAusente(alu, e))"
                                       title="Marcar si el alumno faltó hoy" />
                            </td>
                            <td>
                                <strong>@alu.Apellido, @alu.Nombre</strong>
                            </td>
                            <td>
                                @if (esAusente)
                                {
                                    <span class="badge bg-danger">Inasistencia</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Presente</span>
                                }
                            </td>
                            <td>
                                @if (esAusente)
                                {
                                    var tipo = planilla.TiposDisponibles.FirstOrDefault(t => t.IdTipoInasistencia == alu.IdTipoInasistencia!.Value);
                                    <span class="fw-semibold">@(tipo?.Nombre ?? "Inasistencia")</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge @(alu.CodigoOficial == "P" ? "bg-light text-dark border" : "bg-dark")">
                                    @alu.CodigoOficial
                                </span>
                            </td>
                            <td class="text-center">
                                @if (esAusente)
                                {
                                    @if (alu.Justificada)
                                    {
                                        <span class="badge bg-info text-dark">Sí</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <small>@(string.IsNullOrWhiteSpace(alu.Motivo) ? "-" : alu.Motivo)</small>
                            </td>
                            <td class="text-center">
                                @if (alu.NoComputa)
                                {
                                    <span class="badge bg-warning text-dark">No computa</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (alu.TieneRetiroRegistrado)
                                {
                                    <span class="badge bg-primary text-wrap" style="max-width: 200px;">
                                        @(alu.DetalleRetiroInfo ?? "Retiro anticipado")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => AbrirModalModificar(alu)">
                                    Modificar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@if (mostrarModal && alumnoEditando != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-md modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        Inasistencia: @alumnoEditando.Apellido, @alumnoEditando.Nombre
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tipo de Inasistencia / Condición:</label>
                        <select class="form-select" @bind="modalIdTipoInasistencia">
                            <option value="0">Presente (Sin inasistencia)</option>
                            @if (planilla?.TiposDisponibles != null)
                            {
                                @foreach (var t in planilla.TiposDisponibles)
                                {
                                    <option value="@t.IdTipoInasistencia">
                                        @t.Nombre (@t.CodigoOficial - @t.ValorDecimal.ToString("0.##") falta)
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    @if (modalIdTipoInasistencia > 0)
                    {
                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="chkJustificada" @bind="modalJustificada" />
                            <label class="form-check-label" for="chkJustificada">
                                Inasistencia Justificada (J)
                            </label>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Motivo de la inasistencia:</label>
                            <input type="text" class="form-control" placeholder="Ej: Certificado médico, retiro anticipado..." @bind="modalMotivo" />
                        </div>

                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="chkNoComputa" @bind="modalNoComputa" />
                            <label class="form-check-label" for="chkNoComputa">
                                No Computa (exención ministerial Santa Fe)
                            </label>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Observaciones:</label>
                            <textarea class="form-control" rows="2" placeholder="Observaciones adicionales..." @bind="modalObservaciones"></textarea>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success py-2">
                            El alumno figurará con asistencia completa (Presente).
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="GuardarModal">Aplicar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CursoEscolarDTO> cursos = new();
    private int idCursoSeleccionado = 0;
    private DateTime fechaSeleccionada = DateTime.Today;
    private PlanillaDiariaDTO? planilla;
    private bool cargando = false;
    private bool guardando = false;
    private string mensajeExito = string.Empty;
    private List<string> sugerenciasAplicadas = new();

    // Modal state
    private bool mostrarModal = false;
    private AlumnoAsistenciaItemDTO? alumnoEditando;
    private int modalIdTipoInasistencia = 0;
    private bool modalJustificada = false;
    private string modalMotivo = string.Empty;
    private bool modalNoComputa = false;
    private string modalObservaciones = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await EjecutarAsync(async () =>
        {
            cursos = await CursoClient.GetAllAsync();
            if (cursos.Count > 0)
            {
                idCursoSeleccionado = cursos[0].IdCurso;
                await CargarPlanillaAsync();
            }
        });
    }

    private async Task CargarPlanillaAsync()
    {
        if (idCursoSeleccionado <= 0) return;

        cargando = true;
        mensajeExito = string.Empty;
        MensajeError = string.Empty;
        sugerenciasAplicadas.Clear();

        await EjecutarAsync(async () =>
        {
            planilla = await AsistenciaClient.GetPlanillaDiariaAsync(idCursoSeleccionado, fechaSeleccionada);

            if (planilla != null && !planilla.Confirmada)
            {
                var sugerencias = await AsistenciaClient.SugerirInasistenciasDesdeRetirosAsync(idCursoSeleccionado, fechaSeleccionada);
                var sugerenciasReales = (sugerencias ?? new List<AlumnoAsistenciaItemDTO>())
                    .Where(s => s.TieneRetiroRegistrado && s.IdTipoInasistencia.HasValue && s.IdTipoInasistencia.Value > 0)
                    .ToList();

                foreach (var sug in sugerenciasReales)
                {
                    var alumnoEnPlanilla = planilla.Alumnos.FirstOrDefault(a => a.IdAlumno == sug.IdAlumno);
                    if (alumnoEnPlanilla != null && (!alumnoEnPlanilla.IdTipoInasistencia.HasValue || alumnoEnPlanilla.IdTipoInasistencia <= 0))
                    {
                        alumnoEnPlanilla.IdTipoInasistencia = sug.IdTipoInasistencia;
                        alumnoEnPlanilla.CodigoOficial = sug.CodigoOficial;
                        alumnoEnPlanilla.Justificada = sug.Justificada;
                        alumnoEnPlanilla.Motivo = sug.Motivo;
                        alumnoEnPlanilla.NoComputa = sug.NoComputa;
                        alumnoEnPlanilla.Observaciones = sug.Observaciones;
                        alumnoEnPlanilla.TieneRetiroRegistrado = sug.TieneRetiroRegistrado;
                        alumnoEnPlanilla.DetalleRetiroInfo = sug.DetalleRetiroInfo;
                        alumnoEnPlanilla.IdRetiroOrigen = sug.IdRetiroOrigen;

                        var tipo = planilla.TiposDisponibles?.FirstOrDefault(t => t.IdTipoInasistencia == sug.IdTipoInasistencia);
                        string tipoTexto = tipo != null ? tipo.Nombre : "Inasistencia";
                        sugerenciasAplicadas.Add($"{alumnoEnPlanilla.Apellido}, {alumnoEnPlanilla.Nombre}: {tipoTexto} justificada ({sug.DetalleRetiroInfo ?? sug.Motivo})");
                    }
                }
            }
        });

        cargando = false;
    }

    private void ToggleAusente(AlumnoAsistenciaItemDTO alu, ChangeEventArgs e)
    {
        bool ausente = e.Value is bool b && b;
        if (ausente)
        {
            var tipoCompleta = planilla?.TiposDisponibles?.FirstOrDefault(t => t.CodigoOficial == "A")
                ?? planilla?.TiposDisponibles?.FirstOrDefault();

            alu.IdTipoInasistencia = tipoCompleta?.IdTipoInasistencia ?? 1;
            alu.CodigoOficial = tipoCompleta?.CodigoOficial ?? "A";
            alu.Justificada = false;
            alu.Motivo = string.Empty;
            alu.NoComputa = false;
        }
        else
        {
            alu.IdTipoInasistencia = null;
            alu.CodigoOficial = "P";
            alu.Justificada = false;
            alu.Motivo = string.Empty;
            alu.NoComputa = false;
        }
    }

    private void AbrirModalModificar(AlumnoAsistenciaItemDTO alu)
    {
        alumnoEditando = alu;
        modalIdTipoInasistencia = alu.IdTipoInasistencia ?? 0;
        modalJustificada = alu.Justificada;
        modalMotivo = alu.Motivo ?? string.Empty;
        modalNoComputa = alu.NoComputa;
        modalObservaciones = alu.Observaciones ?? string.Empty;
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        alumnoEditando = null;
    }

    private void GuardarModal()
    {
        if (alumnoEditando == null) return;

        if (modalIdTipoInasistencia > 0)
        {
            alumnoEditando.IdTipoInasistencia = modalIdTipoInasistencia;
            alumnoEditando.Justificada = modalJustificada;
            alumnoEditando.Motivo = modalMotivo;
            alumnoEditando.NoComputa = modalNoComputa;
            alumnoEditando.Observaciones = modalObservaciones;

            var tipo = planilla?.TiposDisponibles?.FirstOrDefault(t => t.IdTipoInasistencia == modalIdTipoInasistencia);
            if (tipo != null)
            {
                if (tipo.ValorDecimal == 1.00m)
                    alumnoEditando.CodigoOficial = modalJustificada ? "J" : "I";
                else
                    alumnoEditando.CodigoOficial = tipo.CodigoOficial;
            }
            else
            {
                alumnoEditando.CodigoOficial = "A";
            }
        }
        else
        {
            alumnoEditando.IdTipoInasistencia = null;
            alumnoEditando.CodigoOficial = "P";
            alumnoEditando.Justificada = false;
            alumnoEditando.Motivo = string.Empty;
            alumnoEditando.NoComputa = false;
            alumnoEditando.Observaciones = string.Empty;
        }

        CerrarModal();
    }

    private async Task GuardarPlanillaAsync()
    {
        if (planilla == null || idCursoSeleccionado <= 0) return;

        guardando = true;
        mensajeExito = string.Empty;
        MensajeError = string.Empty;

        await EjecutarAsync(async () =>
        {
            var request = new GuardarPlanillaAsistenciaRequestDTO
            {
                IdCurso = idCursoSeleccionado,
                Fecha = fechaSeleccionada.Date,
                Inasistencias = planilla.Alumnos
                    .Where(a => a.IdTipoInasistencia.HasValue && a.IdTipoInasistencia.Value > 0)
                    .Select(a => new InasistenciaInputDTO
                    {
                        IdAlumno = a.IdAlumno,
                        IdTipoInasistencia = a.IdTipoInasistencia!.Value,
                        Justificada = a.Justificada,
                        Motivo = a.Motivo ?? string.Empty,
                        NoComputa = a.NoComputa,
                        Observaciones = a.Observaciones ?? string.Empty,
                        IdRetiroOrigen = a.IdRetiroOrigen
                    })
                    .ToList()
            };

            await AsistenciaClient.GuardarPlanillaDiariaAsync(request);
            mensajeExito = "Planilla guardada y confirmada exitosamente.";
            await CargarPlanillaAsync();
        });

        guardando = false;
    }
}
