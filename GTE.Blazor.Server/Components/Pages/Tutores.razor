@page "/tutores"
@attribute [Authorize(Roles = "Secretario,Portero")]
@inherits PaginaConApiBase
@inject TutorApiClient TutoresClient
@inject AlumnoApiClient AlumnosClient
@inject AutorizacionApiClient AutorizacionesClient
@inject CursoEscolarApiClient CursosClient

<h3>Gestión de Tutores</h3>

@if (!string.IsNullOrEmpty(MensajeError))
{
    <div class="alert alert-danger alerta-flotante">@MensajeError</div>
}

<AuthorizeView Roles="Secretario">
    <Authorized>
        <button class="btn btn-primary mb-3" @onclick="AbrirModalNuevo">Nuevo Tutor</button>
    </Authorized>
</AuthorizeView>

<div class="card mb-3">
    <div class="card-body">
        <h6 class="card-subtitle mb-3 text-muted">Buscar por filtros</h6>
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Nombre, apellido o DNI</label>
                <input class="form-control" placeholder="Escribí para filtrar"
                       @bind="filtroTexto" @bind:event="oninput" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Grado del alumno</label>
                <select class="form-control" @bind="filtroGrado">
                    <option value="">Todos</option>
                    @foreach (var grado in GradosDisponibles)
                    {
                        <option value="@grado">@grado</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">División</label>
                <select class="form-control" @bind="filtroDivision">
                    <option value="">Todas</option>
                    @foreach (var division in DivisionesDisponibles)
                    {
                        <option value="@division">@division</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Turno</label>
                <select class="form-control" @bind="filtroTurno">
                    <option value="">Todos</option>
                    @foreach (var turno in TurnosDisponibles)
                    {
                        <option value="@turno">@turno</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Estado del alumno</label>
                <select class="form-control" @bind="filtroEstado">
                    <option value="">Todos</option>
                    <option value="Presente">Presente</option>
                    <option value="Retirado">Retirado</option>
                    <option value="Ausente">Ausente</option>
                </select>
            </div>
        </div>

        <div class="row g-2 align-items-end mt-1">
            <div class="col-md-4">
                <label class="form-label">Parentesco</label>
                <select class="form-control" @bind="filtroParentesco">
                    <option value="">Todos</option>
                    @foreach (var parentesco in ParentescosDisponibles)
                    {
                        <option value="@parentesco">@parentesco</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Restricción</label>
                <select class="form-control" @bind="filtroRestriccion">
                    <option value="todos">Todos</option>
                    <option value="si">Sólo con restricción</option>
                    <option value="no">Sólo sin restricción</option>
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-secondary" @onclick="LimpiarFiltros">Limpiar</button>
            </div>
        </div>
    </div>
</div>

@if (tutores == null)
{
    <p><em>Cargando...</em></p>
}
else if (tutores.Count == 0)
{
    <p>No hay tutores registrados.</p>
}
else if (!TutoresFiltrados.Any())
{
    <p>No se encontraron tutores con esos filtros.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>Nombre y Apellido</th>
                <th>DNI</th>
                <th>Parentesco</th>
                <th>Teléfono</th>
                <th>Usuario</th>
                <th>Restricción</th>
                <AuthorizeView Roles="Secretario">
                    <Authorized><th class="text-center" style="width: 180px;">Acciones</th></Authorized>
                </AuthorizeView>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in TutoresFiltrados)
            {
                <tr>
                    <td>@t.Nombre @t.Apellido</td>
                    <td>@t.Dni</td>
                    <td>@t.Parentesco</td>
                    <td>@t.Telefono</td>
                    <td>@t.NombreUsuario</td>
                    <td>@(t.TieneRestriccion ? "Sí" : "No")</td>
                    <AuthorizeView Roles="Secretario">
                        <Authorized>
                            <td class="text-center text-nowrap">
                                <button class="btn btn-sm btn-outline-warning me-1" @onclick="() => AbrirModalEditar(t)">Editar</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => Eliminar(t.IdTutor)">Borrar</button>
                            </td>
                        </Authorized>
                    </AuthorizeView>
                </tr>
            }
        </tbody>
    </table>
}

@if (mostrarModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(tutorEditando.IdTutor == 0 ? "Nuevo Tutor" : "Editar Tutor")</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="tutorEditando" OnValidSubmit="Guardar">
                        <div class="mb-3">
                            <label>Nombre</label>
                            <InputText @bind-Value="tutorEditando.Nombre" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label>Apellido</label>
                            <InputText @bind-Value="tutorEditando.Apellido" class="form-control" />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label>DNI</label>
                                <InputText @bind-Value="tutorEditando.Dni" class="form-control" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label>Parentesco</label>
                                <InputText @bind-Value="tutorEditando.Parentesco" class="form-control" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label>Teléfono</label>
                                <InputText @bind-Value="tutorEditando.Telefono" class="form-control" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label>Usuario</label>
                                <InputText @bind-Value="tutorEditando.NombreUsuario" class="form-control" disabled="@esEdicion" />
                            </div>
                        </div>
                        @if (!esEdicion)
                        {
                            <div class="mb-3">
                                <label>Contraseña</label>
                                <InputText type="password" @bind-Value="tutorEditando.Contrasena" class="form-control" />
                            </div>
                        }
                        <div class="form-check mb-3">
                            <InputCheckbox @bind-Value="tutorEditando.TieneRestriccion" class="form-check-input" />
                            <label class="form-check-label">Tiene restricción legal para retirar</label>
                        </div>
                        <div class="mt-4 text-end">
                            <button type="button" class="btn btn-secondary me-2" @onclick="CerrarModal">Cancelar</button>
                            <button type="submit" class="btn btn-primary">Guardar</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<TutorDTO>? tutores;
    private List<AlumnoDTO> alumnos = new();
    private List<AutorizacionDTO> autorizaciones = new();
    private List<CursoEscolarDTO> cursos = new();
    private TutorDTO tutorEditando = new();
    private bool mostrarModal;
    private bool esEdicion;
    private string? filtroTexto;
    private string filtroParentesco = string.Empty;
    private string filtroRestriccion = "todos";
    private string filtroGrado = string.Empty;
    private string filtroDivision = string.Empty;
    private string filtroTurno = string.Empty;
    private string filtroEstado = string.Empty;

    private IEnumerable<string> ParentescosDisponibles =>
        (tutores ?? new List<TutorDTO>())
            .Select(t => t.Parentesco)
            .Where(p => !string.IsNullOrWhiteSpace(p))
            .Distinct()
            .OrderBy(p => p);

    private IEnumerable<string> GradosDisponibles =>
        cursos.Select(c => c.Grado).Distinct().OrderBy(g => g);

    private IEnumerable<string> DivisionesDisponibles =>
        cursos.Select(c => c.Curso).Distinct().OrderBy(d => d);

    private IEnumerable<string> TurnosDisponibles =>
        cursos.Select(c => c.Turno).Distinct().OrderBy(t => t);

    private IEnumerable<TutorDTO> TutoresFiltrados =>
        (tutores ?? new List<TutorDTO>()).Where(t =>
            (string.IsNullOrWhiteSpace(filtroTexto)
                || t.Nombre.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase)
                || t.Apellido.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase)
                || t.Dni.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase))
            && (string.IsNullOrEmpty(filtroParentesco) || t.Parentesco == filtroParentesco)
            && (filtroRestriccion == "todos"
                || (filtroRestriccion == "si" && t.TieneRestriccion)
                || (filtroRestriccion == "no" && !t.TieneRestriccion))
            && TutoresConAlumnosQueCumplen().Contains(t.IdTutor));

    private HashSet<int> TutoresConAlumnosQueCumplen()
    {
        bool hayFiltroDelAlumno = !string.IsNullOrEmpty(filtroGrado)
            || !string.IsNullOrEmpty(filtroDivision)
            || !string.IsNullOrEmpty(filtroTurno)
            || !string.IsNullOrEmpty(filtroEstado);

        if (!hayFiltroDelAlumno)
            return (tutores ?? new List<TutorDTO>()).Select(t => t.IdTutor).ToHashSet();

        var alumnosQueCumplen = alumnos
            .Where(a => (string.IsNullOrEmpty(filtroGrado) || a.Grado == filtroGrado)
                && (string.IsNullOrEmpty(filtroDivision) || a.Curso == filtroDivision)
                && (string.IsNullOrEmpty(filtroTurno) || a.Turno == filtroTurno)
                && (string.IsNullOrEmpty(filtroEstado) || a.Estado == filtroEstado))
            .Select(a => a.IdAlumno)
            .ToHashSet();

        return autorizaciones
            .Where(a => alumnosQueCumplen.Contains(a.AlumnoId))
            .Select(a => a.TutorId)
            .ToHashSet();
    }

    private void LimpiarFiltros()
    {
        filtroTexto = null;
        filtroParentesco = string.Empty;
        filtroRestriccion = "todos";
        filtroGrado = string.Empty;
        filtroDivision = string.Empty;
        filtroTurno = string.Empty;
        filtroEstado = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        await EjecutarAsync(CargarDatos);
    }

    private async Task CargarDatos()
    {
        tutores = await TutoresClient.GetAllAsync();

        alumnos = await AlumnosClient.GetAllAsync();
        autorizaciones = await AutorizacionesClient.GetAllAsync();
        cursos = await CursosClient.GetAllAsync();
    }

    private void AbrirModalNuevo()
    {
        tutorEditando = new TutorDTO();
        esEdicion = false;
        mostrarModal = true;
    }

    private void AbrirModalEditar(TutorDTO tutor)
    {
        tutorEditando = new TutorDTO
        {
            IdTutor = tutor.IdTutor,
            Nombre = tutor.Nombre,
            Apellido = tutor.Apellido,
            Dni = tutor.Dni,
            Parentesco = tutor.Parentesco,
            Telefono = tutor.Telefono,
            TieneRestriccion = tutor.TieneRestriccion,
            NombreUsuario = tutor.NombreUsuario,
            Contrasena = string.Empty
        };
        esEdicion = true;
        mostrarModal = true;
    }

    private void CerrarModal() => mostrarModal = false;

    private async Task Guardar()
    {
        await EjecutarAsync(async () =>
        {
            if (esEdicion)
                await TutoresClient.UpdateAsync(tutorEditando);
            else
                await TutoresClient.AddAsync(tutorEditando);

            mostrarModal = false;
            await CargarDatos();
        });
    }

    private async Task Eliminar(int id)
    {
        await EjecutarAsync(async () =>
        {
            await TutoresClient.DeleteAsync(id);
            await CargarDatos();
        });
    }
}
