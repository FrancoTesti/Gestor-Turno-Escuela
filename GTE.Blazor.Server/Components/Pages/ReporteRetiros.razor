@page "/reporteretiros"
@attribute [Authorize(Roles = "Secretario,Portero")]
@inherits PaginaConApiBase
@inject GTE.Clients.ReporteApiClient ReporteClient
@using GTE.DTOs

<h3>Reporte: Retiros por Rango de Fechas</h3>

@if (!string.IsNullOrEmpty(MensajeError))
{
    <div class="alert alert-danger">@MensajeError</div>
}

<div class="row mb-4 align-items-end">
    <div class="col-md-3">
        <label>Desde:</label>
        <InputDate @bind-Value="fechaDesde" class="form-control" />
    </div>
    <div class="col-md-3">
        <label>Hasta:</label>
        <InputDate @bind-Value="fechaHasta" class="form-control" />
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary w-100" @onclick="Consultar">Consultar</button>
    </div>
</div>

@if (retiros == null) { <p><em>Seleccione un rango y presione Consultar...</em></p> }
else if (retiros.Count == 0) { <p>No se encontraron retiros en este período.</p> }
else
{
    <div class="list-group">
        @foreach (var r in retiros)
        {
            <div class="list-group-item list-group-item-action">
                <div class="d-flex w-100 justify-content-between cursor-pointer" @onclick="() => ToggleDetalle(r.IdRetiro)" style="cursor: pointer;">
                    <h5 class="mb-1">Retiro ID: @r.IdRetiro - @r.FechaHora.ToString("dd/MM/yyyy HH:mm")</h5>
                    <small>@r.Detalles.Count alumnos</small>
                </div>
                <p class="mb-1"><strong>Tutor:</strong> @r.TutorNombreCompleto | <strong>Personal:</strong> @r.PersonalNombre</p>
                <small><strong>Obs:</strong> @r.Observaciones</small>

                @if (retiroExpandido == r.IdRetiro)
                {
                    <div class="mt-3 p-3 bg-light border rounded">
                        <h6>Detalle de Alumnos</h6>
                        <table class="table table-sm table-bordered">
                            <thead class="table-secondary">
                                <tr>
                                    <th>Alumno</th>
                                    <th>Hora Salida</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in r.Detalles)
                                {
                                    <tr>
                                        <td>@d.AlumnoNombreCompleto</td>
                                        <td>@d.HoraSalida.ToString(@"hh\:mm")</td>
                                        <td>@d.Estado</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private DateTime? fechaDesde = DateTime.Today.AddDays(-30);
    private DateTime? fechaHasta = DateTime.Today;
    private List<RetiroDTO>? retiros;
    private int retiroExpandido = 0;

    protected override async Task OnInitializedAsync()
    {
        await Consultar();
    }

    private async Task Consultar()
    {
        await EjecutarAsync(async () => {
            retiros = await ReporteClient.GetRetirosAsync(fechaDesde, fechaHasta);
            retiroExpandido = 0; // cerrar detalles abiertos
        });
    }

    private void ToggleDetalle(int idRetiro)
    {
        if (retiroExpandido == idRetiro)
            retiroExpandido = 0;
        else
            retiroExpandido = idRetiro;
    }
}
