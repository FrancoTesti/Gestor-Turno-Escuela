@page "/cartelera"
@layout EmptyLayout
@inject CarteleraApiClient CarteleraClient
@implements IDisposable

<PageTitle>Salida de cursos</PageTitle>



<div class="cartelera">
    <div class="cartelera-encabezado">
        <h1>Salida de cursos</h1>
        <span class="cartelera-reloj">@horaActual.ToString(@"HH\:mm")</span>
    </div>

    @if (!cargado && !hayError)
    {
        <div class="cartelera-centro">
            <p class="cartelera-grande">Conectando...</p>
            <p class="cartelera-chico">Esperando la información de la escuela</p>
        </div>
    }
    else if (!cargado)
    {
        <div class="cartelera-centro">
            <p class="cartelera-grande">Sin conexión</p>
            <p class="cartelera-chico">Reintentando...</p>
        </div>
    }
    else if (cartelera.EnSalida.Count == 0)
    {
        <div class="cartelera-centro">
            <p class="cartelera-grande">No hay ningún curso saliendo</p>
            @if (cartelera.Proximo is not null)
            {
                <p class="cartelera-chico">
                    Próximo: @cartelera.Proximo.Grado @cartelera.Proximo.Curso
                    a las @cartelera.Proximo.HorarioSalida.ToString(@"hh\:mm")
                </p>
            }
            <p class="cartelera-chico">Actualizado a las @ultimaActualizacion?.ToString(@"HH\:mm")</p>
        </div>
    }
    else
    {
        <div class="cartelera-cursos">
            @foreach (var curso in cartelera.EnSalida)
            {
                <div class="cartelera-curso">
                    <p class="cartelera-curso-nombre">@curso.Grado @curso.Curso</p>
                    <p class="cartelera-curso-dato">Turno @curso.Turno</p>
                    <p class="cartelera-curso-dato">
                        @(curso.CantidadDeAlumnos == 1 ? "1 alumno" : $"{curso.CantidadDeAlumnos} alumnos")
                    </p>
                    <p class="cartelera-curso-pie">
                        @TextoDeLaPuerta(curso)
                    </p>
                </div>
            }

            <p class="cartelera-actualizado">Actualizado a las @ultimaActualizacion?.ToString(@"HH\:mm")</p>
        </div>
    }

    @if (hayError && cargado)
    {
        <p class="cartelera-aviso">
            Sin conexión: se muestra la última información y se sigue intentando.
        </p>
    }
</div>

<style>
    .cartelera {
        min-height: 88vh;
        background: #0d1b2a;
        color: #f8f9fa;
        border-radius: 12px;
        padding: 24px 32px 32px;
        display: flex;
        flex-direction: column;
    }

    .cartelera-encabezado {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        border-bottom: 1px solid #1b3a5c;
        padding-bottom: 12px;
    }

    .cartelera-encabezado h1 {
        font-size: 2.2rem;
        font-weight: 600;
        margin: 0;
    }

    .cartelera-reloj {
        font-size: 2.2rem;
        font-weight: 600;
        color: #8ecae6;
        font-variant-numeric: tabular-nums;
    }

    .cartelera-centro {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .cartelera-grande {
        font-size: 3.4rem;
        font-weight: 700;
        margin: 0;
    }

    .cartelera-chico {
        font-size: 1.8rem;
        color: #a9c5dd;
        margin-top: 12px;
    }

    .cartelera-cursos {
        flex: 1;
        display: flex;
        flex-wrap: wrap;
        align-content: center;
        justify-content: center;
        gap: 24px;
        padding-top: 24px;
    }

    .cartelera-curso {
        min-width: 340px;
        background: #16324f;
        border: 1px solid #2a5b8c;
        border-radius: 16px;
        padding: 28px 32px;
        text-align: center;
    }

    .cartelera-curso-nombre {
        font-size: 5rem;
        font-weight: 700;
        line-height: 1;
        margin: 0;
    }

    .cartelera-curso-dato {
        font-size: 1.6rem;
        color: #a9c5dd;
        margin: 10px 0 0;
    }

    .cartelera-curso-pie {
        font-size: 1.2rem;
        color: #7fa1bf;
        margin: 18px 0 0;
    }

    .cartelera-aviso {
        margin: 12px 0 0;
        text-align: center;
        color: #ffd166;
        font-size: 1.1rem;
    }

    .cartelera-actualizado {
        width: 100%;
        margin: 24px 0 0;
        text-align: center;
        color: #7fa1bf;
        font-size: 1rem;
        font-variant-numeric: tabular-nums;
    }
</style>

@code {
    private CarteleraDTO cartelera = new();
    private DateTime horaActual = DateTime.Now;
    private DateTime? ultimaActualizacion;
    private bool cargado;
    private bool hayError;
    private readonly CancellationTokenSource cancelacion = new();

    protected override async Task OnAfterRenderAsync(bool primerRender)
    {
        if (!primerRender)
            return;

        await ActualizarAsync();
        StateHasChanged();

        _ = RefrescarCadaTresSegundosAsync();
    }

    private async Task RefrescarCadaTresSegundosAsync()
    {
        while (!cancelacion.IsCancellationRequested)
        {
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(3), cancelacion.Token);
                await ActualizarAsync();
                await InvokeAsync(StateHasChanged);
            }
            catch (OperationCanceledException)
            {
                break;
            }
            catch (Exception)
            {
            }
        }
    }

    private async Task ActualizarAsync()
    {
        horaActual = DateTime.Now;

        try
        {
            cartelera = await CarteleraClient.GetAsync();
            ultimaActualizacion = DateTime.Now;
            cargado = true;
            hayError = false;
        }
        catch (Exception)
        {
            hayError = true;
        }
    }

    private static string TextoDeLaPuerta(CursoEnSalidaDTO curso)
    {
        string hora = curso.FechaHoraInicio.ToString(@"HH\:mm");

        return string.IsNullOrWhiteSpace(curso.Puerta)
            ? $"Desde las {hora}"
            : $"Sale por {curso.Puerta} desde las {hora}";
    }

    public void Dispose() => cancelacion.Cancel();
}
