@page "/"
@attribute [Authorize]
@inject IAuthService AuthService

<PageTitle>Inicio</PageTitle>

<div class="mb-4">
    <h2 class="mb-1">Hola, @nombreCompleto</h2>
    <p class="text-muted mb-0">
        Entraste como <strong>@rol</strong>. Estas son las secciones que tenés disponibles.
    </p>
</div>

@foreach (var seccion in secciones)
{
    <section class="mb-4">
        <h6 class="text-uppercase text-muted mb-3">@seccion.Titulo</h6>

        <div class="row g-3">
            @foreach (var acceso in seccion.Accesos)
            {
                <div class="col-sm-6 col-xl-4">
                    <a class="card h-100 text-decoration-none shadow-sm tarjeta-inicio" href="@acceso.Direccion">
                        <div class="card-body py-3">
                            <h5 class="card-title mb-0">@acceso.Titulo</h5>
                        </div>
                    </a>
                </div>
            }
        </div>
    </section>
}

@code {
    private string? nombreCompleto;
    private string? rol;
    private List<Seccion> secciones = new();

    protected override async Task OnInitializedAsync()
    {
        nombreCompleto = await AuthService.GetNombreCompletoAsync()
            ?? await AuthService.GetUsernameAsync();
        rol = await AuthService.GetRoleAsync();

        secciones = ArmarSecciones(rol)
            .Where(seccion => seccion.Accesos.Count > 0)
            .ToList();
    }

    private static List<Seccion> ArmarSecciones(string? rol)
    {
        return new List<Seccion>
        {
            new("Día a día", new List<Acceso>
            {
                new("Salidas de curso", "salidas", "Secretario", "Portero"),
                new("Retiros", "retiros", "Secretario", "Portero"),
                new("Alumnos", "alumnos", "Secretario", "Portero"),
                new("Horarios especiales", "horariosespeciales", "Secretario", "Portero"),
                new("Mis alumnos", "mis-alumnos", "Tutor")
            }),
            new("Administración", new List<Acceso>
            {
                new("Cursos", "cursos", "Secretario", "Portero", "Tutor"),
                new("Tutores", "tutores", "Secretario", "Portero"),
                new("Autorizaciones", "autorizaciones", "Secretario", "Portero")
            }),
            new("Reportes", new List<Acceso>
            {
                new("Reporte de alumnos", "reportealumnos", "Secretario"),
                new("Reporte de retiros", "reporteretiros", "Secretario", "Portero")
            })
        }
        .Select(seccion => new Seccion(
            seccion.Titulo,
            seccion.Accesos.Where(acceso => acceso.EsPara(rol)).ToList()))
        .ToList();
    }

    private sealed class Acceso
    {
        private readonly string[] rolesPermitidos;

        public Acceso(string titulo, string direccion, params string[] roles)
        {
            Titulo = titulo;
            Direccion = direccion;
            rolesPermitidos = roles;
        }

        public string Titulo { get; }
        public string Direccion { get; }

        public bool EsPara(string? rol) =>
            rol is not null && rolesPermitidos.Contains(rol, StringComparer.OrdinalIgnoreCase);
    }

    private sealed class Seccion
    {
        public Seccion(string titulo, List<Acceso> accesos)
        {
            Titulo = titulo;
            Accesos = accesos;
        }

        public string Titulo { get; }
        public List<Acceso> Accesos { get; }
    }
}
