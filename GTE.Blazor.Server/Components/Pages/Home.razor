@page "/"
@attribute [Authorize]
@inject IAuthService AuthService

<PageTitle>Inicio</PageTitle>

<div class="mb-4">
    <h2 class="mb-1">Hola, @nombreCompleto</h2>
    <p class="text-muted mb-0">
        Entraste como <strong>@rol</strong>. Estas son las secciones que tenés disponibles.
    </p>
</div>

@* Las mismas secciones y el mismo orden que el menú de la izquierda, para que
   sea fácil ubicarse en cualquiera de las dos. *@
@foreach (var seccion in secciones)
{
    <section class="mb-4">
        <h6 class="text-uppercase text-muted mb-3">@seccion.Titulo</h6>

        <div class="row g-3">
            @foreach (var acceso in seccion.Accesos)
            {
                <div class="col-sm-6 col-xl-4">
                    <a class="card h-100 text-decoration-none shadow-sm tarjeta-inicio" href="@acceso.Direccion">
                        <div class="card-body">
                            <h5 class="card-title">@acceso.Titulo</h5>
                            <p class="card-text text-muted mb-0">@acceso.Descripcion</p>
                        </div>
                    </a>
                </div>
            }
        </div>
    </section>
}

@code {
    private string? nombreCompleto;
    private string? rol;
    private List<Seccion> secciones = new();

    protected override async Task OnInitializedAsync()
    {
        nombreCompleto = await AuthService.GetNombreCompletoAsync()
            ?? await AuthService.GetUsernameAsync();
        rol = await AuthService.GetRoleAsync();

        secciones = ArmarSecciones(rol)
            .Where(seccion => seccion.Accesos.Count > 0)
            .ToList();
    }

    private static List<Seccion> ArmarSecciones(string? rol)
    {
        return new List<Seccion>
        {
            new("Día a día", new List<Acceso>
            {
                new("Salidas de curso",
                    "Marcá qué curso está saliendo. La pantalla de la puerta lo muestra al instante.",
                    "salidas", "Secretario", "Portero"),
                new("Retiros",
                    "Registrá la entrega de alumnos a un tutor autorizado.",
                    "retiros", "Secretario", "Portero"),
                new("Alumnos",
                    "Consultá el listado, buscá por curso o turno y administrá los legajos.",
                    "alumnos", "Secretario", "Portero"),
                new("Horarios especiales",
                    "Cargá las salidas a una hora distinta por una actividad puntual.",
                    "horariosespeciales", "Secretario", "Portero"),
                new("Mis alumnos",
                    "Los alumnos a tu cargo, con su curso, horario de salida y estado.",
                    "mis-alumnos", "Tutor")
            }),
            new("Administración", new List<Acceso>
            {
                new("Cursos",
                    "Grados, divisiones, turnos y horario de salida de cada curso.",
                    "cursos", "Secretario", "Portero", "Tutor"),
                new("Tutores",
                    "Datos de contacto de los adultos autorizados a retirar.",
                    "tutores", "Secretario", "Portero"),
                new("Autorizaciones",
                    "Definí qué tutor puede retirar a cada alumno.",
                    "autorizaciones", "Secretario", "Portero")
            }),
            new("Reportes", new List<Acceso>
            {
                new("Reporte de alumnos",
                    "Cantidad de alumnos por curso y turno, con gráfico.",
                    "reportealumnos", "Secretario", "Portero"),
                new("Reporte de retiros",
                    "Retiros de un período, con el detalle de los alumnos.",
                    "reporteretiros", "Secretario", "Portero")
            })
        }
        .Select(seccion => new Seccion(
            seccion.Titulo,
            seccion.Accesos.Where(acceso => acceso.EsPara(rol)).ToList()))
        .ToList();
    }

    /// <summary>Una pantalla a la que se puede entrar desde el inicio.</summary>
    private sealed class Acceso
    {
        private readonly string[] rolesPermitidos;

        public Acceso(string titulo, string descripcion, string direccion, params string[] roles)
        {
            Titulo = titulo;
            Descripcion = descripcion;
            Direccion = direccion;
            rolesPermitidos = roles;
        }

        public string Titulo { get; }
        public string Descripcion { get; }
        public string Direccion { get; }

        public bool EsPara(string? rol) =>
            rol is not null && rolesPermitidos.Contains(rol, StringComparer.OrdinalIgnoreCase);
    }

    /// <summary>Grupo de pantallas que se muestra con un título.</summary>
    private sealed class Seccion
    {
        public Seccion(string titulo, List<Acceso> accesos)
        {
            Titulo = titulo;
            Accesos = accesos;
        }

        public string Titulo { get; }
        public List<Acceso> Accesos { get; }
    }
}
